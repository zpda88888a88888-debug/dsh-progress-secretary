{
  "name": "dsh-progress-secretary",
  "version": "0.7.4",
  "description": "工作进度小秘书 — a workspace progress notebook for DeepSeek Harness with two manual operations: record progress and brief progress",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "notebook",
    "progress"
  ],
  "license": "MIT",
  "author": "zpda88888a88888-debug",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zpda88888a88888-debug/dsh-progress-secretary.git"
  },
  "homepage": "https://github.com/zpda88888a88888-debug/dsh-progress-secretary#readme",
  "bugs": {
    "url": "https://github.com/zpda88888a88888-debug/dsh-progress-secretary/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./notebook": "./lib/notebook.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/notebook.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "marketplace": {
      "profiles": [
        "web"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.3": "compatible",
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  }
}
